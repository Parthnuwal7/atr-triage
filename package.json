{
  "name": "atr-triage",
  "version": "0.1.0",
  "description": "Local ARIA log triage & grading tool",
  "type": "module",
  "engines": { "node": ">=18.0.0", "pnpm": ">=8.0.0" },
  "scripts": {
    "triage": "tsx src/cli.ts",
    "migrate": "tsx src/cli.ts migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.8.0",
    "vitest": "^2.0.0"
  }
}
